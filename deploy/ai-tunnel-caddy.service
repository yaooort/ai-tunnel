[Unit]
Description=AI Tunnel HTTPS gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
[Service]
User=ai-tunnel
Group=ai-tunnel
Environment=HOME=/var/lib/ai-tunnel/caddy
ExecStart=/opt/ai-tunnel/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
ExecReload=/opt/ai-tunnel/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-tunnel/caddy
UMask=0077
[Install]
WantedBy=multi-user.target
